{
  "version": 6,
  "configurePresets": [
    {
      "name": "default",
      "displayName": "Default",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "MOYI_BUILD_CLI": "ON",
        "MOYI_BUILD_ONNX_RUNTIME": "ON",
        "MOYI_BUILD_TESTS": "ON",
        "MOYI_BUILD_C_API": "ON"
      }
    },
    {
      "name": "edge-release",
      "displayName": "Edge Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/edge-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "MOYI_BUILD_CLI": "ON",
        "MOYI_BUILD_ONNX_RUNTIME": "ON",
        "MOYI_BUILD_TESTS": "ON",
        "MOYI_BUILD_C_API": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "edge-release",
      "configurePreset": "edge-release"
    }
  ]
}
